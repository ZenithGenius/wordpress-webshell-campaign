**/*.bin
**/shells-raw/

# --- Jekyll / GitHub Pages build output ---
_site/
.jekyll-cache/
.jekyll-metadata
vendor/
.bundle/

# --- Playwright scratch ---
.playwright-mcp/

# --- OS / editor noise ---
.DS_Store
*.swp
